# ── Sanity CMS ─────────────────────────────────────────────────────────────────
# Found in your Sanity project dashboard at sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-03-01

# ── Email delivery (Resend) ─────────────────────────────────────────────────────
# Get a free API key at resend.com — add and verify your sending domain first
RESEND_API_KEY=
# Must match a verified sender domain in your Resend dashboard
# e.g. "Country Materials <noreply@countrymaterial.com>"
RESEND_FROM_EMAIL=
